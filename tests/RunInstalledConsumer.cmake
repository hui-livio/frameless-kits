function(run)
    execute_process(COMMAND ${ARGV} RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
    if(NOT result STREQUAL "0")
        message(FATAL_ERROR "Command failed (${result}): ${ARGV}\n${output}\n${error}")
    endif()
endfunction()
set(prefix "${BUILD_DIR}/tests/installed/${CONFIG}")
run("${CMAKE_COMMAND}" --install "${BUILD_DIR}" --config "${CONFIG}" --prefix "${prefix}")
# Binary packages must not install implementation sources for consumers to compile.
file(STRINGS "${BUILD_DIR}/install_manifest.txt" installed_files)
foreach(installed_file IN LISTS installed_files)
    if(installed_file MATCHES "\\.(c|cc|cpp|cxx)$")
        message(FATAL_ERROR "Installed package contains implementation source: ${installed_file}")
    endif()
endforeach()
set(frontends)
if(WIDGETS)
    list(APPEND frontends Widgets)
endif()
if(QUICK)
    list(APPEND frontends Quick)
endif()
if(WIDGETS AND QUICK)
    list(APPEND frontends Mixed)
endif()
set(generator_args -G "${GENERATOR}")
if(PLATFORM)
    list(APPEND generator_args -A "${PLATFORM}")
endif()
if(TOOLSET)
    list(APPEND generator_args -T "${TOOLSET}")
endif()
foreach(frontend IN LISTS frontends)
    set(consumer_dir "${BUILD_DIR}/tests/consumer-${frontend}/${CONFIG}")
    run("${CMAKE_COMMAND}" -S "${SOURCE_DIR}/tests/consumer" -B "${consumer_dir}"
        ${generator_args} "-DCMAKE_CXX_COMPILER=${CXX_COMPILER}"
        "-DCMAKE_BUILD_TYPE=${CONFIG}" "-DCONSUMER_FRONTEND=${frontend}"
        "-DFramelessKit_DIR=${prefix}/${INSTALL_LIBDIR}/cmake/FramelessKit"
        "-DQt6_DIR=${QT6_DIR}"
    )
    run("${CMAKE_COMMAND}" --build "${consumer_dir}" --config "${CONFIG}" --parallel 4)
    file(READ "${consumer_dir}/executable-${CONFIG}.txt" executable)
    if(WIN32)
        cmake_path(CONVERT "${prefix}/bin;${QT_BIN_DIR};$ENV{PATH}" TO_NATIVE_PATH_LIST runtime_path)
        set(ENV{PATH} "${runtime_path}")
    elseif(APPLE)
        set(ENV{DYLD_LIBRARY_PATH} "${prefix}/${INSTALL_LIBDIR}:$ENV{DYLD_LIBRARY_PATH}")
    else()
        set(ENV{LD_LIBRARY_PATH} "${prefix}/${INSTALL_LIBDIR}:$ENV{LD_LIBRARY_PATH}")
    endif()
    run("${executable}")
    message(STATUS "Installed ${frontend} consumer configured, built and ran successfully")
endforeach()
