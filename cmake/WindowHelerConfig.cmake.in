@PACKAGE_INIT@
set(WindowHeler_QML_IMPORT_PATH "@PACKAGE_WINDOWHELER_QML_INSTALL_DIR@")
include(CMakeFindDependencyMacro)
if("@WINDOWHELER_PRIVATE_QT_VERSION@" STREQUAL "")
    find_dependency(Qt6 6.8 COMPONENTS Core Gui)
else()
    find_dependency(Qt6 @WINDOWHELER_PRIVATE_QT_VERSION@ EXACT COMPONENTS Core Gui)
endif()
if(@WINDOWHELER_BUILD_WIDGETS@)
    find_dependency(Qt6 6.8 COMPONENTS Widgets)
endif()
if(@WINDOWHELER_BUILD_QUICK@)
    find_dependency(Qt6 6.8 COMPONENTS Qml Quick)
endif()
include("${CMAKE_CURRENT_LIST_DIR}/WindowHelerTargets.cmake")
set(WindowHeler_Runtime_FOUND TRUE)
if(@WINDOWHELER_BUILD_FRAMELESS@ AND @WINDOWHELER_BUILD_WIDGETS@)
    set(WindowHeler_FramelessWidgets_FOUND TRUE)
else()
    set(WindowHeler_FramelessWidgets_FOUND FALSE)
endif()
if(@WINDOWHELER_BUILD_MATERIAL@ AND @WINDOWHELER_BUILD_WIDGETS@)
    set(WindowHeler_MaterialWidgets_FOUND TRUE)
else()
    set(WindowHeler_MaterialWidgets_FOUND FALSE)
endif()
if(@WINDOWHELER_BUILD_FRAMELESS@ AND @WINDOWHELER_BUILD_QUICK@)
    set(WindowHeler_FramelessQuick_FOUND TRUE)
else()
    set(WindowHeler_FramelessQuick_FOUND FALSE)
endif()
if(@WINDOWHELER_BUILD_MATERIAL@ AND @WINDOWHELER_BUILD_QUICK@)
    set(WindowHeler_MaterialQuick_FOUND TRUE)
else()
    set(WindowHeler_MaterialQuick_FOUND FALSE)
endif()
if(WindowHeler_FIND_COMPONENTS)
    foreach(component IN LISTS WindowHeler_FIND_COMPONENTS)
        if(component MATCHES "Widgets$")
            find_dependency(Qt6 6.8 COMPONENTS Widgets)
        elseif(component MATCHES "Quick$")
            find_dependency(Qt6 6.8 COMPONENTS Qml Quick)
        elseif(NOT component STREQUAL "Runtime" AND NOT TARGET WindowHeler::${component})
            set(WindowHeler_${component}_FOUND FALSE)
        endif()
    endforeach()
endif()
check_required_components(WindowHeler)
