@PACKAGE_INIT@
set(FramelessKit_QML_IMPORT_PATH "@PACKAGE_FRAMELESSKIT_QML_INSTALL_DIR@")
include(CMakeFindDependencyMacro)
if(NOT "@FRAMELESSKIT_PRIVATE_QT_VERSION@" STREQUAL "")
    # The optional Wayland adapter uses Qt QPA. Match its build-time Qt ABI;
    # installed consumers do not need Qt private development headers.
    find_dependency(Qt6 @FRAMELESSKIT_PRIVATE_QT_VERSION@ EXACT COMPONENTS Core Gui)
else()
    find_dependency(Qt6 6.8 COMPONENTS Core Gui)
endif()
set(FramelessKit_Core_FOUND TRUE)
set(FramelessKit_Widgets_FOUND @FRAMELESSKIT_BUILD_WIDGETS@)
set(FramelessKit_Quick_FOUND @FRAMELESSKIT_BUILD_QUICK@)
include("${CMAKE_CURRENT_LIST_DIR}/FramelessKitCoreTargets.cmake")
if(NOT FramelessKit_FIND_COMPONENTS)
    set(FramelessKit_FIND_COMPONENTS Core)
endif()
foreach(component IN LISTS FramelessKit_FIND_COMPONENTS)
    if(component STREQUAL "Widgets" AND FramelessKit_Widgets_FOUND)
        if(FramelessKit_FIND_REQUIRED_Widgets)
            find_dependency(Qt6 6.8 COMPONENTS Widgets)
        else()
            # Optional frontends must not inherit the package's REQUIRED flag.
            find_package(Qt6 6.8 QUIET OPTIONAL_COMPONENTS Widgets)
            if(NOT Qt6Widgets_FOUND)
                set(FramelessKit_Widgets_FOUND FALSE)
                continue()
            endif()
        endif()
        include("${CMAKE_CURRENT_LIST_DIR}/FramelessKitWidgetsTargets.cmake")
    elseif(component STREQUAL "Quick" AND FramelessKit_Quick_FOUND)
        if(FramelessKit_FIND_REQUIRED_Quick)
            find_dependency(Qt6 6.8 COMPONENTS Qml Quick)
        else()
            find_package(Qt6 6.8 QUIET OPTIONAL_COMPONENTS Qml Quick)
            if(NOT Qt6Qml_FOUND OR NOT Qt6Quick_FOUND)
                set(FramelessKit_Quick_FOUND FALSE)
                continue()
            endif()
        endif()
        include("${CMAKE_CURRENT_LIST_DIR}/FramelessKitQuickTargets.cmake")
    elseif(NOT component STREQUAL "Core")
        set(FramelessKit_${component}_FOUND FALSE)
    endif()
endforeach()
check_required_components(FramelessKit)
